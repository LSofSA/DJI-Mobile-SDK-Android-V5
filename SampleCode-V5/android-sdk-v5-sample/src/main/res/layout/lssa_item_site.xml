<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="#DBDBDB"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    tools:ignore="HardcodedText">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/lssaTextViewSiteName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Site Name"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/lssaButtonDeleteSite"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/lssaTextViewSitePhotoCounter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Total Photos:"
            android:textSize="18sp"
            app:layout_constraintEnd_toStartOf="@+id/lssaButtonDeleteSite"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lssaTextViewSiteName" />

        <TextView
            android:id="@+id/lssaTextViewSiteDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="1900/01/01"
            app:layout_constraintBottom_toBottomOf="@+id/lssaButtonDeleteSite"
            app:layout_constraintEnd_toStartOf="@+id/lssaButtonDeleteSite"
            app:layout_constraintTop_toBottomOf="@id/lssaTextViewSiteName"
            tools:textAlignment="center" />

        <ImageButton
            android:id="@+id/lssaButtonDeleteSite"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="@color/lssa_red"
            android:contentDescription="Delete site"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>