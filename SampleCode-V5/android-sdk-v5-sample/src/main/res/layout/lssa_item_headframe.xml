<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="2dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@android:color/white">

    <androidx.cardview.widget.CardView
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        app:cardCornerRadius="4dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/black">

        <TextView
            android:id="@+id/lssaTextViewHeadFrameAltitude"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="45.0m"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/lssaTextViewHeadFrameNumber"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="2dp"
        android:text="Head Frame 1"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        android:ellipsize="end"
        android:singleLine="true" />

    <Button
        android:id="@+id/lssaButtonDeleteHeadFrame"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:backgroundTint="@color/lssa_red"
        android:contentDescription="Delete head frame"
        android:padding="8dp"
        android:background="@drawable/ic_close" />
</LinearLayout>
