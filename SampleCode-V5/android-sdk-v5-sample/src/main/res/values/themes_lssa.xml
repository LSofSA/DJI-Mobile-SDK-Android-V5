<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- LSSA Theme - Automatically switches between light/dark -->
    <style name="LSSATheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:screenOrientation">landscape</item>

        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/lssa_primary</item>
        <item name="colorPrimaryDark">@color/lssa_primary_dark</item>
        <item name="colorAccent">@color/lssa_accent</item>

        <!-- Background and text -->
        <item name="android:windowBackground">@color/lssa_background</item>
        <item name="android:textColorPrimary">@color/lssa_text</item>
        <item name="android:textColorSecondary">@color/lssa_text_secondary</item>

        <!-- Button colors -->
        <item name="android:buttonStyle">@style/LSSA_Button</item>
    </style>

    <!-- LSSA Button Style -->
    <style name="LSSA_Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@color/lssa_primary</item>
        <item name="android:textColor">@color/lssa_surface</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">12dp</item>
    </style>

    <!-- LSSA Text Styles -->
    <style name="LSSA_HeaderText">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/lssa_text</item>
    </style>

    <style name="LSSA_BodyText">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/lssa_text</item>
    </style>

    <style name="LSSA_SecondaryText">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/lssa_text_secondary</item>
    </style>
</resources>